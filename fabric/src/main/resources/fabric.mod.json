{
  "schemaVersion": 1,
  "id": "carrotsortingpatch",
  "version": "${version}",
  "name": "CarrotCraft Sorting Patch",
  "description": "CarrotCraftのエンダーチェスト画面で、インベントリソートModが操作用スロットを動かさないよう守るクライアント専用Mod",
  "authors": [
    "CountyClaw4",
    "CarrotCraft"
  ],
  "contact": {
    "homepage": "https://github.com/carrot-craft/carrotsortingpatch",
    "sources": "https://github.com/carrot-craft/carrotsortingpatch",
    "issues": "https://github.com/carrot-craft/carrotsortingpatch/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.countyclaaw4.carrotcraftsortingpatch.CarrotSortingPatchFabric"
    ],
    "modmenu": [
      "io.github.countyclaaw4.carrotcraftsortingpatch.modmenu.CarrotSortingPatchModMenuApi"
    ]
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": true
    }
  },
  "mixins": [
    "carrotsortingpatch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_min}",
    "minecraft": "${minecraft_version_range_fabric}",
    "java": ">=${java_version}"
  }
}
